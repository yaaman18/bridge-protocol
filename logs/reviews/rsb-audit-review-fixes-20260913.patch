 function audit_history_summary(history::Tuple)
     _validate_history(history)
+    previous = Dict{String,Tuple{Int,AuditContext}}()
+    context_shifts = Dict{String,Any}[]
+    for (sequence, event) in enumerate(history)
+        context = event.context
+        if haskey(previous, context.question_id)
+            from_sequence, before = previous[context.question_id]
+            changed = [String(field) for field in fieldnames(AuditContext)
+                       if getfield(before, field) != getfield(context, field)]
+            isempty(changed) || push!(context_shifts, Dict{String,Any}(
+                "question_id" => context.question_id,
+                "from_sequence" => from_sequence, "to_sequence" => sequence,
+                "changed_fields" => changed,
+                "before" => _context_dict(before), "after" => _context_dict(context)))
+        end
+        previous[context.question_id] = (sequence, context)
+    end
     latest = Dict(event.context.question_id => event.status for event in history)
     counts = Dict(String(status) => count(==(status), values(latest)) for status in AUDIT_STATUSES)
     (; event_count=length(history), question_count=length(latest), counts,
        unresolved_count=counts["open"] + counts["underdetermined"],
+       context_shift_count=length(context_shifts), context_shifts,
