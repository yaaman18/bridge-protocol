theorem ERIEC.FieldBridge.boundary_subset_support.{u} : ∀ {Cell : Type u}
  (witness : ERIEC.FieldBridge.PeriodicBoundaryWitness Cell), witness.boundary ⊆ witness.support :=
fun {Cell} witness ⦃cell⦄ hcell => ((witness.exact_boundary cell).mp hcell).left
