structure ERIEC.FieldBridge.PeriodicBoundaryWitness.{u} (Cell : Type u) : Type u
number of parameters: 1
fields:
  ERIEC.FieldBridge.PeriodicBoundaryWitness.neighbors : Cell → Set Cell
