  ERIEC.FieldBridge.PeriodicBoundaryWitness.exact_boundary : ∀ (cell : Cell),
      cell ∈ self.boundary ↔ cell ∈ self.support ∧ ∃ neighbor, neighbor ∈ self.neighbors cell ∧ ¬neighbor ∈ self.support
constructor:
  ERIEC.FieldBridge.PeriodicBoundaryWitness.mk.{u} {Cell : Type u} (neighbors : Cell → Set Cell)
    (support boundary : Set Cell)
    (exact_boundary :
      ∀ (cell : Cell), cell ∈ boundary ↔ cell ∈ support ∧ ∃ neighbor, neighbor ∈ neighbors cell ∧ ¬neighbor ∈ support) :
