import ERIEC.DC
import ERIEC.Value

/-!
AGENCY-001 (specs/packets/AGENCY-001.md): two audit targets between DC (self-maintenance) and
phenomenal mattering, as an unratified experiment. Not imported by the main library.

* `Agent` (L2): DC, the structural value of environment couplings (`Value.viabilityContribution`),
  actions that differ with that value, and `ValueNeeded`: over a declared family of perturbations,
  survival with the value-tracking units strictly dominates survival without them.
* `SelfProducing` (L3): without its own activity the system's structure persists under no declared
  condition, and with its own activity it persists under some condition.
* `SelfRepairing` (deepened L3, user decision of 2026-10-24): over a nonempty declared family of
  damages, every lost constituent is regenerated by the system's own activity, and none is without it.

The separation theorems below show only that the tiers are logically distinct: DC does not give
agency, agency does not give phenomenal mattering, and neither DC nor agency gives structural
self-production. The substance is in the measurement (tools/AgencySubstrate). "Consciousness" is not
used as a name (P-11).
-/

namespace ERIEC.Agency

/-- The two variants compared by an ablation: the system as it is, and the system with the
ablated units silenced. -/
inductive Variant
  | intact
  | ablated
  deriving DecidableEq

/-- A declared family of perturbations `P`; `survives p v` says that, under perturbation `p`, the
variant `v` keeps itself over the declared horizon. -/
structure SurvivalTrial (P : Type*) where
  survives : P → Variant → Prop

/-- Survival strictly dominates without a threshold (P-05): some perturbation is survived only with
the value-tracking units, and none is survived only without them. -/
def ValueNeeded {P : Type*} (t : SurvivalTrial P) : Prop :=
  (∃ p, t.survives p .intact ∧ ¬ t.survives p .ablated) ∧
  (∀ p, t.survives p .ablated → t.survives p .intact)

/-- Actions differ between two environment couplings of different structural value. -/
def ValueDifferentiated {E A : Type*} (value : E → Nat) (act : E → Set A) : Prop :=
  ∃ e₁ e₂, value e₁ ≠ value e₂ ∧ act e₁ ≠ act e₂

/-- L2: an agent in the audit sense. The value is the endogenous structural value of Value.lean. -/
structure Agent (M E C S P A : Type*) [DecidableEq C] where
  dc : DC M E C S
  nuPhi : Finset C
  contribution : E → Finset C
  act : E → Set A
  differentiated : ValueDifferentiated (Value.viabilityContribution nuPhi contribution) act
  trial : SurvivalTrial P
  needed : ValueNeeded trial

/-- A declared family of conditions `Q`; `structurePersists q v` says that the system's constituents
(its connections) persist over the horizon under `q`, with its own activity (`intact`) or with its
activity silenced (`ablated`). -/
structure StructureTrial (Q : Type*) where
  structurePersists : Q → Variant → Prop

/-- L3: without activity the structure persists under no condition (precarious), and with its own
activity it persists under some condition (self-produced). -/
def SelfProducing {Q : Type*} (t : StructureTrial Q) : Prop :=
  (∀ q, ¬ t.structurePersists q .ablated) ∧ (∃ q, t.structurePersists q .intact)

/-- A declared family of damages `D` (in the substrate: silencing one core unit until the connections
it sends have decayed to nothing); `repaired d v` says that, after damage `d`, the lost constituents
are back and the system persists, with its own activity (`intact`) or without it (`ablated`). -/
structure RepairTrial (D : Type*) where
  repaired : D → Variant → Prop

/-- Deepened L3: some damage is declared, every declared damage is repaired by the system's own
activity, and none is repaired without it. Required for every damage, not for some (P-06). -/
def SelfRepairing {D : Type*} (t : RepairTrial D) : Prop :=
  Nonempty D ∧ (∀ d, t.repaired d .intact) ∧ (∀ d, ¬ t.repaired d .ablated)

/-! ### A small DC model: one constituent, one action, two environment couplings -/

namespace Model

def alphaR : Unit → Set Bool := fun _ => {true}
def sigmaR : Bool → Set Unit := fun b => if b then Set.univ else ∅
def piR : Unit → Set Unit := fun _ => Set.univ
def rhoR : Unit → Set Unit := fun _ => Set.univ
def kappa : Unit → Set Unit := fun _ => Set.univ
def eps : Unit → Set Bool := fun _ => {true}

def dc : DC Unit Bool Unit Unit where
  alphaRel := alphaR
  sigmaRel := sigmaR
  piRel := piR
  rhoRel := rhoR
  kappa := kappa
  epsilon := eps
  boundary := Set.univ
  s := ()
  hSelf := by
    intro x _
    simp [Closure.Phi, Closure.pi_star, Closure.rho_star, piR, rhoR, kappa]
  hSMC := by
    intro e he
    simp only [eps, Set.mem_singleton_iff] at he
    subst he
    simp [Hinge.T_prime, Adj.alpha_star, Adj.sigma_star, alphaR, sigmaR, eps]
  hAct := ⟨(), by simp [Hinge.Act, Closure.rho_star, Adj.sigma_star, rhoR, sigmaR, kappa, eps]⟩
  hBound := ⟨(), by simp [kappa]⟩

def nuPhi : Finset Unit := {()}
def contribution : Bool → Finset Unit := fun b => if b then {()} else ∅
def act : Bool → Set Bool := fun b => {b}

theorem value_true : Value.viabilityContribution nuPhi contribution true = 1 := by
  decide

theorem value_false : Value.viabilityContribution nuPhi contribution false = 0 := by
  decide

theorem differentiated :
    ValueDifferentiated (Value.viabilityContribution nuPhi contribution) act :=
  ⟨true, false, by rw [value_true, value_false]; decide, by
    intro h
    have : true ∈ act false := by rw [← h]; simp [act]
    simp [act] at this⟩

/-- Survival with the value-tracking units, and no survival without them. -/
def needingTrial : SurvivalTrial Unit := ⟨fun _ v => v = .intact⟩

theorem needed : ValueNeeded needingTrial :=
  ⟨⟨(), rfl, fun h => by cases h⟩, fun _ h => by cases h⟩

/-- Survival that does not depend on the ablation at all. -/
def indifferentTrial : SurvivalTrial Unit := ⟨fun _ _ => True⟩

theorem not_needed : ¬ ValueNeeded indifferentTrial := by
  rintro ⟨⟨_, _, h⟩, _⟩
  exact h trivial

def agency : Agent Unit Bool Unit Unit Unit Bool where
  dc := dc
  nuPhi := nuPhi
  contribution := contribution
  act := act
  differentiated := differentiated
  trial := needingTrial
  needed := needed

/-- Structure that persists whether or not the system is active (given from outside). -/
def staticStructure : StructureTrial Unit := ⟨fun _ _ => True⟩

theorem not_selfProducing : ¬ SelfProducing staticStructure := by
  rintro ⟨h, _⟩
  exact h () trivial

/-- Structure that persists exactly when the system is active. -/
def producedStructure : StructureTrial Unit := ⟨fun _ v => v = .intact⟩

theorem selfProducing : SelfProducing producedStructure :=
  ⟨fun _ h => (by cases h), ⟨(), rfl⟩⟩

/-- A damage that the system does not repair (a constituent lost for good). -/
def unrepaired : RepairTrial Unit := ⟨fun _ _ => False⟩

theorem not_selfRepairing : ¬ SelfRepairing unrepaired := by
  rintro ⟨_, h, _⟩
  exact h ()

/-- A damage repaired exactly when the system is active. -/
def repairedByActivity : RepairTrial Unit := ⟨fun _ v => v = .intact⟩

theorem selfRepairing : SelfRepairing repairedByActivity :=
  ⟨⟨()⟩, fun _ => rfl, fun _ h => by cases h⟩

end Model

/-! ### Separation -/

/-- DC does not give agency: a DC system can come with a survival trial that the ablation does
not affect. -/
theorem dc_does_not_entail_valueNeeded :
    ∃ (_ : DC Unit Bool Unit Unit) (t : SurvivalTrial Unit), ¬ ValueNeeded t :=
  ⟨Model.dc, Model.indifferentTrial, Model.not_needed⟩

/-- Agency does not give phenomenal mattering: an agent whose coupling has structural weight, with
mattering false everywhere. Any implication from agency to mattering is refuted by this model. -/
theorem agency_does_not_entail_mattering :
    ¬ (∀ (a : Agent Unit Bool Unit Unit Unit Bool) (mattering : Value.PhenomenalMattering Bool),
        Value.HasStructuralWeight a.nuPhi a.contribution true → mattering true) := by
  intro h
  have hw : Value.HasStructuralWeight Model.agency.nuPhi Model.agency.contribution true := by
    show 0 < Value.viabilityContribution Model.nuPhi Model.contribution true
    rw [Model.value_true]; decide
  exact h Model.agency (fun _ => False) hw

/-- Neither DC nor agency gives structural self-production: the agent above can come with a
structure that persists without its activity. -/
theorem agency_does_not_entail_selfProducing :
    ∃ (_ : Agent Unit Bool Unit Unit Unit Bool) (t : StructureTrial Unit), ¬ SelfProducing t :=
  ⟨Model.agency, Model.staticStructure, Model.not_selfProducing⟩

/-- Structural self-production does not give self-repair, in the weak sense of the other separation
theorems: the two predicates are independent (a self-producing structure trial and an unrepaired
repair trial both exist). The trials are not tied to one system, so this is close to trivial. -/
theorem selfProducing_does_not_entail_selfRepairing :
    ∃ (t : StructureTrial Unit) (r : RepairTrial Unit), SelfProducing t ∧ ¬ SelfRepairing r :=
  ⟨Model.producedStructure, Model.unrepaired, Model.selfProducing, Model.not_selfRepairing⟩

/-- Self-repair is not vacuous: it is satisfiable. -/
theorem selfRepairing_satisfiable : ∃ r : RepairTrial Unit, SelfRepairing r :=
  ⟨Model.repairedByActivity, Model.selfRepairing⟩

/-- Agency gives DC (it is part of the structure). -/
theorem agency_dc {M E C S P A : Type*} [DecidableEq C] (a : Agent M E C S P A) :
    (Hinge.Act a.dc.rhoRel a.dc.sigmaRel a.dc.kappa a.dc.epsilon a.dc.s).Nonempty :=
  a.dc.hAct

end ERIEC.Agency

#print axioms ERIEC.Agency.ValueNeeded
#print axioms ERIEC.Agency.SelfProducing
#print axioms ERIEC.Agency.Model.dc
#print axioms ERIEC.Agency.Model.agency
#print axioms ERIEC.Agency.dc_does_not_entail_valueNeeded
#print axioms ERIEC.Agency.agency_does_not_entail_mattering
#print axioms ERIEC.Agency.agency_does_not_entail_selfProducing
#print axioms ERIEC.Agency.agency_dc
#print axioms ERIEC.Agency.SelfRepairing
#print axioms ERIEC.Agency.selfProducing_does_not_entail_selfRepairing
